{
    "$schema": "https://json.schemastore.org/claude-code-settings.json",
    "permissions": {
        "allow": [
            "Bash(git status *)",
            "PowerShell(git status *)",
            "Bash(git diff *)",
            "PowerShell(git diff *)",
            "Bash(git log *)",
            "PowerShell(git log *)",
            "Bash(git show *)",
            "PowerShell(git show *)",
            "Bash(git ls-files *)",
            "PowerShell(git ls-files *)",
            "Bash(git rev-parse *)",
            "PowerShell(git rev-parse *)",
            "Bash(git blame *)",
            "PowerShell(git blame *)",
            "Bash(git branch --show-current)",
            "PowerShell(git branch --show-current)",
            "Bash(git remote -v)",
            "PowerShell(git remote -v)",
            "Bash(bun run lint)",
            "PowerShell(bun run lint)",
            "Bash(bun run typecheck)",
            "PowerShell(bun run typecheck)",
            "Bash(bun run format:check)",
            "PowerShell(bun run format:check)",
            "Bash(bun run build)",
            "PowerShell(bun run build)",
            "Bash(bun run test)",
            "PowerShell(bun run test)",
            "Bash(bunx prettier --check *)",
            "PowerShell(bunx prettier --check *)",
            "Bash(bunx commitlint *)",
            "PowerShell(bunx commitlint *)",
            "Bash(bunx playwright test *)",
            "PowerShell(bunx playwright test *)",
            "Bash(npx vitest run *)",
            "PowerShell(npx vitest run *)"
        ],
        "ask": [
            "Edit(/packages/registry/src/ui/**)",
            "Bash(git push *)",
            "PowerShell(git push *)",
            "Bash(gh pr create *)",
            "PowerShell(gh pr create *)",
            "Bash(gh pr edit *)",
            "PowerShell(gh pr edit *)",
            "Bash(gh pr comment *)",
            "PowerShell(gh pr comment *)",
            "Bash(gh pr review *)",
            "PowerShell(gh pr review *)",
            "Bash(gh issue create *)",
            "PowerShell(gh issue create *)",
            "Bash(gh issue comment *)",
            "PowerShell(gh issue comment *)",
            "Bash(gh release *)",
            "PowerShell(gh release *)",
            "Bash(gh api *)",
            "PowerShell(gh api *)"
        ],
        "deny": [
            "Bash(git commit *--no-verify*)",
            "PowerShell(git commit *--no-verify*)",
            "Bash(git commit -n *)",
            "PowerShell(git commit -n *)",
            "Bash(git commit * -n *)",
            "PowerShell(git commit * -n *)",
            "Bash(git commit -nm*)",
            "PowerShell(git commit -nm*)",
            "Bash(git commit -mn*)",
            "PowerShell(git commit -mn*)",
            "Bash(git push *--no-verify*)",
            "PowerShell(git push *--no-verify*)",
            "Bash(HUSKY=0 *)",
            "PowerShell($env:HUSKY*)",
            "Bash(git -c *)",
            "PowerShell(git -c *)",
            "Bash(git push)",
            "PowerShell(git push)",
            "Bash(git push *--force*)",
            "PowerShell(git push *--force*)",
            "Bash(git push -f*)",
            "PowerShell(git push -f*)",
            "Bash(git push * -f*)",
            "PowerShell(git push * -f*)",
            "Bash(git push *+*)",
            "PowerShell(git push *+*)",
            "Bash(git push *--all*)",
            "PowerShell(git push *--all*)",
            "Bash(git push *--mirror*)",
            "PowerShell(git push *--mirror*)",
            "Bash(git push *HEAD:*)",
            "PowerShell(git push *HEAD:*)",
            "Bash(git push * main)",
            "PowerShell(git push * main)",
            "Bash(git push * main *)",
            "PowerShell(git push * main *)",
            "Bash(git push *:main*)",
            "PowerShell(git push *:main*)",
            "Bash(git push *refs/heads/main*)",
            "PowerShell(git push *refs/heads/main*)",
            "Bash(git push * develop)",
            "PowerShell(git push * develop)",
            "Bash(git push * develop *)",
            "PowerShell(git push * develop *)",
            "Bash(git push *:develop*)",
            "PowerShell(git push *:develop*)",
            "Bash(git push *refs/heads/develop*)",
            "PowerShell(git push *refs/heads/develop*)",
            "Bash(git reset --hard*)",
            "PowerShell(git reset --hard*)",
            "Bash(git clean *)",
            "PowerShell(git clean *)",
            "Bash(git diff *--output*)",
            "PowerShell(git diff *--output*)",
            "Bash(git log *--output*)",
            "PowerShell(git log *--output*)",
            "Bash(git show *--output*)",
            "PowerShell(git show *--output*)",
            "Bash(gh pr merge *)",
            "PowerShell(gh pr merge *)",
            "Bash(bun --bun vitest*)",
            "PowerShell(bun --bun vitest*)",
            "Bash(bunx --bun vitest*)",
            "PowerShell(bunx --bun vitest*)",
            "Edit(/apps/docs/installed/**)",
            "Edit(/apps/docs/public/r/**)",
            "Edit(/packages/tokens/src/css/springs.generated.css)",
            "Read(/**/.env)",
            "Read(/**/.env.local)",
            "Read(/**/.env.*.local)",
            "Read(/**/*.pem)",
            "Read(/**/*.key)",
            "Read(/**/*.p12)",
            "Read(/**/*.pfx)"
        ]
    }
}
