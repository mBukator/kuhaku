{
    "name": "docs",
    "version": "0.0.8",
    "private": true,
    "scripts": {
        "build": "bun run install:registry && next build",
        "dev": "bun run install:registry && next dev",
        "install:registry": "bun run scripts/install-registry.ts",
        "start": "next start",
        "test": "playwright test",
        "typecheck": "bun run install:registry && fumadocs-mdx && next typegen && tsc --noEmit",
        "postinstall": "fumadocs-mdx",
        "lint": "eslint"
    },
    "dependencies": {
        "@base-ui/react": "^1.7.0",
        "@kuhaku/tokens": "workspace:*",
        "class-variance-authority": "^0.7.1",
        "cn": "^0.2.5",
        "fumadocs-core": "16.14.2",
        "fumadocs-mdx": "15.2.2",
        "fumadocs-ui": "npm:@fumadocs/base-ui@16.12.1",
        "lucide-react": "^1.47.0",
        "motion": "^12.42.2",
        "next": "16.4.1",
        "react": "^19.2.8",
        "react-dom": "^19.2.8"
    },
    "devDependencies": {
        "@playwright/test": "~1.63.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@types/mdast": "^4.0.4",
        "@types/mdx": "^2.0.14",
        "@types/node": "^26.1.1",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "postcss": "^8.5.21",
        "shadcn": "^4.21.1",
        "tailwindcss": "^4.3.3",
        "typescript": "^6.0.3",
        "eslint": "^9.39.4",
        "eslint-config-next": "16.4.1",
        "mdast-util-mdx-jsx": "^3.2.0"
    }
}
